<!-- Línea inferior -->
<div class="border-t border-gray-800 mt-6 pt-6 text-center text-xs text-gray-500">
  © {new Date().getFullYear()} M-Technology. Todos los derechos reservados.<br />
  <a href="#" id="condiciones-link" class="underline hover:text-green-600">Condiciones de uso</a>
</div>
<!-- Modal -->
<div id="modal-condiciones" class="fixed inset-0 bg-black/60 z-50 hidden">
  <div class="flex items-center justify-center min-h-screen">
    <div class="bg-white/90 rounded-lg p-8 max-w-lg w-full relative text-gray-800">
      <button id="close-modal" class="absolute top-2 right-2 text-gray-600 hover:text-green-600 text-2xl">&times;</button>
      <h2 class="text-xl font-bold mb-4">Condiciones de uso</h2>
      <div class="text-sm max-h-96 overflow-y-auto space-y-4">
        <p><strong>1. Aceptación de las condiciones</strong><br />Al acceder y utilizar este sitio web de M-Technology, usted acepta cumplir con estas condiciones de uso y todas las leyes aplicables.</p>
        <p><strong>2. Propiedad intelectual</strong><br />Todo el contenido, logotipos y software en este sitio son propiedad de M-Technology o sus licenciantes.</p>
        <p><strong>3. Uso permitido</strong><br />Usted puede usar este sitio solo para fines personales y no comerciales.</p>
        <p><strong>4. Limitación de responsabilidad</strong><br />M-Technology no se hace responsable de daños derivados del uso o imposibilidad de uso de este sitio web.</p>
        <p><strong>5. Enlaces a terceros</strong><br />Este sitio puede contener enlaces a sitios externos. M-Technology no se responsabiliza por su contenido.</p>
        <p><strong>6. Modificaciones</strong><br />Podemos actualizar estas condiciones en cualquier momento.</p>
        <p><strong>7. Ley aplicable</strong><br />Estas condiciones se rigen por las leyes vigentes en Colombia.</p>
      </div>
    </div>
  </div>
</div>
<script type="module" is:inline>
  const link = document.getElementById('condiciones-link');
  const modal = document.getElementById('modal-condiciones');
  const close = document.getElementById('close-modal');
  link?.addEventListener('click', (e) => { e.preventDefault(); modal.classList.remove('hidden'); });
  close?.addEventListener('click', () => { modal.classList.add('hidden'); });
  modal?.addEventListener('click', (e) => { if (e.target === modal) modal.classList.add('hidden'); });
</script>
</footer>