               class="w-5 h-5 transition-transform duration-300 group-hover:scale-110 group-hover:brightness-110" />
          <a href="https://wa.me/3019030729" target="_blank" 
             class="text-green-600 hover:underline transition-colors">+57 3019030729</a>
        </li>

        <li class="flex items-center gap-2 group">
          <img src="https://upload.wikimedia.org/wikipedia/commons/a/a5/Instagram_icon.png" 
